# ─── Branding ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=FilmyWave
NEXT_PUBLIC_SITE_URL=https://betamovie.up.railway.app
NEXT_PUBLIC_LOGO_PATH=/filmywave-logo.png

# ─── Contact ─────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=contact@filmywave.com

# ─── Social ──────────────────────────────────────────────────
NEXT_PUBLIC_TWITTER_HANDLE=@filmywave

# ─── Analytics & Verification ────────────────────────────────
# Get from Google Analytics → Data Streams → Measurement ID
NEXT_PUBLIC_GA_ID=
# Get from Google Search Console → Verify via HTML tag
NEXT_PUBLIC_GSC_VERIFICATION=

# ─── Download Proxy ──────────────────────────────────────────
# URL of a CORS proxy used for the download button
# e.g. https://yourworker.your-subdomain.workers.dev/api/proxy
NEXT_PUBLIC_DOWNLOAD_PROXY_URL=

# ─── Telegram Bot ────────────────────────────────────────────
# Your bot's username (without @) for deep links
NEXT_PUBLIC_BOT_USERNAME=

# ─── TMDB API ────────────────────────────────────────────────
TMDB_API_KEY=

# ─── Gmail OTP Login ─────────────────────────────────────────
# Gmail address that sends the login codes
GMAIL_USER=
# Google Account → Security → App passwords (16 chars, no spaces)
GMAIL_APP_PASSWORD=
# Random long string used to sign session cookies
AUTH_SECRET=

# ─── MongoDB (movie catalogue + users) ───────────────────────
MONGODB_URI=
# More clusters (all are searched together):
MONGODB_URI_2=
MONGODB_URI_3=
# Leave empty: the site searches every database for your movies
MONGODB_DB=

# Optional: only if you run a separate movie API server. Leave empty to use the built-in library (/admin/library).
INTERNAL_API_URL=
NEXT_PUBLIC_ENABLE_PLAYER_ADS=false

# ─── Movie library in MongoDB ────────────────────────────────
# Optional. Leave empty and the site finds your movie collection automatically
# (any fields like title/name/file_name + url/link/stream_url or Telegram file_id).
MONGODB_COLLECTION=
# Telegram files (file_id) play in our own player.
# BUILT-IN (recommended, any size, no extra server). Use the SAME bot that saved the files to MongoDB:
# Optional now: leave empty, defaults work with just TELEGRAM_BOT_TOKEN
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Other options (optional):
# 1) Your Telegram stream server, e.g. https://yourstream.app/dl/{file_id}  (any file size)
TG_STREAM_URL=
# 2) Bot token from @BotFather (Telegram only allows files up to 20 MB this way)
TELEGRAM_BOT_TOKEN=
