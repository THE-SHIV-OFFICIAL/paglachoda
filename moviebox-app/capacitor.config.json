{
  "appId": "com.betabothub.moviebox",
  "appName": "MOVIE BOX",
  "webDir": "www",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#090909"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#090909",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#090909"
    }
  }
}
